# EasyOCR is the local OCR engine. The first run may download missing weights.
MODEL_DIR=models/easyocr

# OCR inference and confidence routing
CONFIDENCE_THRESHOLD=0.5
OCR_RETRY_CONFIDENCE=0.60
OCR_ORIENTATION_CONFIDENCE=0.30
OCR_CANVAS_SIZE=3200
OCR_WIDTH_THRESHOLD=0.5

# Upload and document rendering limits
MAX_UPLOAD_SIZE_MB=10
DOCUMENT_MAX_PAGES=20
DOCUMENT_DPI=200

# Logging
LOGGING_LEVEL=INFO

# Optional cross-origin browser access. Keep empty for same-origin usage.
# Set a JSON array, for example: ["https://your-frontend.example"]
CORS_ALLOW_ORIGINS=[]

# Docker only: trusted reverse-proxy IPs/CIDRs; do not use * in production.
FORWARDED_ALLOW_IPS=127.0.0.1
